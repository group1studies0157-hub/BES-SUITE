# ── Virtual environment (regenerable from requirements.txt) ──────────────────
venv/
env/
.venv/

# ── Python bytecode / caches ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Secrets / API keys — never commit ────────────────────────────────────────
.env
.env.*
*.key
secrets.json
config.local.*

# ── Build / packaging artifacts ──────────────────────────────────────────────
build/
dist/
*.egg-info/
.eggs/
*.spec

# ── Test / coverage ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── OS cruft ─────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ── Generated CAD output (uncomment if you don't want these tracked) ──────────
# *.dxf
# *.lsp
# output/
# temp/
